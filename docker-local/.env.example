# Copy to .env and fill in. .env is gitignored.

# matecat-filters (file conversion) — get a key at
# https://rapidapi.com/translated/api/matecat-filters/
FILTERS_RAPIDAPI_KEY=

# LexiQA integration
# LXQ_LICENSE   : local licence key (defined in lexiqa_new server_config.js)
# LXQ_PARTNERID : partner id for localhost (server_config.js urlToPartnerIdMap.localhost)
# LXQ_SERVER    : URL of the local lexiqa_new server (browser reaches it directly)
LXQ_LICENSE=
LXQ_PARTNERID=matecat
LXQ_SERVER=http://localhost:8181
