# Copy to .env and fill in. .env is gitignored.

# matecat-filters (file conversion) — get a key at
# https://rapidapi.com/translated/api/matecat-filters/
FILTERS_RAPIDAPI_KEY=

# LexiQA integration
# LXQ_LICENSE   : local licence key (defined in lexiqa_new server_config.js)
# LXQ_PARTNERID : partner id for localhost (server_config.js urlToPartnerIdMap.localhost)
# LXQ_SERVER    : browser-facing URL of the local lexiqa_new server (fetches run in the browser)
# LXQ_SERVER_INTERNAL : server-to-server URL for backend calls (matecat container -> host)
LXQ_LICENSE=
LXQ_PARTNERID=matecat
LXQ_SERVER=http://localhost:8181
LXQ_SERVER_INTERNAL=http://host.docker.internal:8181
# LexiQA Basic Auth (server-to-server createWithData): apiKeys name + key (partnerIds must include LXQ_PARTNERID)
LXQ_API_USER=matecat
LXQ_API_KEY=
